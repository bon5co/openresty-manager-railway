# Front proxy on Railway's PORT. Upstream (oms) listens HTTPS on 127.0.0.1:34567 with a self-signed cert.
daemon off;
pid /tmp/om-front/nginx.pid;
error_log /dev/stderr warn;
worker_processes 2;
events { worker_connections 1024; }

http {
    access_log off;
    client_body_temp_path /tmp/om-front/body;
    proxy_temp_path       /tmp/om-front/proxy;
    fastcgi_temp_path     /tmp/om-front/fcgi;
    uwsgi_temp_path       /tmp/om-front/uwsgi;
    scgi_temp_path        /tmp/om-front/scgi;

    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    # Upstream answers 400 when no token is presented; an unauthenticated caller must see 401.
    map "$http_authorization$arg_token" $om_no_token { "" 1; default 0; }

    server {
        listen ${PORT};
        listen [::]:${PORT};
        server_name _;
        client_max_body_size 512m;

        location /api/v1/admin/ {
            if ($om_no_token) { return 401 '{"error":"missing token"}\n'; }
            proxy_pass https://127.0.0.1:34567;
            proxy_ssl_verify off;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location / {
            proxy_pass https://127.0.0.1:34567;
            proxy_ssl_verify off;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }
}
